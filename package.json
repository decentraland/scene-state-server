{
  "name": "@dcl/scene-state-server",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose --passWithNoTests",
    "lint:check": "npx eslint . --ext .ts",
    "lint:fix": "npx eslint . --ext .ts --fix",
    "dev": "nodemon"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^1.1.12",
    "@types/node": "^20.5.7",
    "@well-known-components/test-helpers": "^1.5.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/crypto": "^3.4.5",
    "@dcl/ecs": "^7.8.21",
    "@dcl/js-runtime": "^7.8.21",
    "@dcl/platform-crypto-middleware": "^1.0.2",
    "@dcl/protocol": "^1.0.0-16079089845.commit-0e8c31f",
    "@types/ws": "^8.18.1",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/fetch-component": "^2.0.2",
    "@well-known-components/http-server": "^2.1.0",
    "@well-known-components/interfaces": "^1.4.2",
    "@well-known-components/logger": "^3.1.3",
    "@well-known-components/metrics": "^2.0.1",
    "ws": "^8.18.2"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "DEV=true ts-node ./src/index.ts"
  }
}
